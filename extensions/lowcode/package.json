{
  "name": "lowcode",
  "displayName": "WigglyCode LowCode",
  "description": "WigglyCode low-code designer integration.",
  "version": "0.0.1",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./out/extension",
  "browser": "./dist/browser/extension",
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onCommand:wigglycode.lowcode.openDesigner",
    "onCommand:wigglycode.lowcode.initializeProject",
    "onCommand:wigglycode.lowcode.designMode",
    "onCommand:wigglycode.lowcode.previewMode",
    "onCommand:wigglycode.lowcode.codeMode",
    "onCommand:wigglycode.lowcode.selectTool",
    "onCommand:wigglycode.lowcode.panTool",
    "onCommand:wigglycode.lowcode.zoomOut",
    "onCommand:wigglycode.lowcode.zoomIn",
    "onCommand:wigglycode.lowcode.resetViewport",
    "onCommand:wigglycode.lowcode.undo",
    "onCommand:wigglycode.lowcode.redo",
    "onCommand:wigglycode.lowcode.save",
    "onCommand:wigglycode.lowcode.share",
    "onCommand:wigglycode.lowcode.publish",
    "onCommand:wigglycode.lowcode.insertComponent",
    "onView:wigglycode.project",
    "onView:wigglycode.components",
    "onView:wigglycode.variables",
    "onView:wigglycode.datasources",
    "onView:wigglycode.outline"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "wigglycode.lowcode.openDesigner",
        "title": "Open Page Designer",
        "category": "WigglyCode"
      },
      {
        "command": "wigglycode.lowcode.initializeProject",
        "title": "Initialize Project",
        "category": "WigglyCode"
      },
      {
        "command": "wigglycode.lowcode.designMode",
        "title": "Design",
        "category": "WigglyCode",
        "icon": "$(edit)"
      },
      {
        "command": "wigglycode.lowcode.previewMode",
        "title": "Preview",
        "category": "WigglyCode",
        "icon": "$(preview)"
      },
      {
        "command": "wigglycode.lowcode.codeMode",
        "title": "Code",
        "category": "WigglyCode",
        "icon": "$(code)"
      },
      {
        "command": "wigglycode.lowcode.selectTool",
        "title": "Pan Tool Active",
        "category": "WigglyCode",
        "icon": "$(move)"
      },
      {
        "command": "wigglycode.lowcode.panTool",
        "title": "Pan Tool",
        "category": "WigglyCode",
        "icon": "$(move)"
      },
      {
        "command": "wigglycode.lowcode.zoomOut",
        "title": "Zoom Out",
        "category": "WigglyCode",
        "icon": "$(zoom-out)"
      },
      {
        "command": "wigglycode.lowcode.zoomIn",
        "title": "Zoom In",
        "category": "WigglyCode",
        "icon": "$(zoom-in)"
      },
      {
        "command": "wigglycode.lowcode.resetViewport",
        "title": "Reset Viewport",
        "category": "WigglyCode",
        "icon": "$(target)"
      },
      {
        "command": "wigglycode.lowcode.undo",
        "title": "Undo",
        "category": "WigglyCode",
        "icon": "$(discard)"
      },
      {
        "command": "wigglycode.lowcode.redo",
        "title": "Redo",
        "category": "WigglyCode",
        "icon": "$(redo)"
      },
      {
        "command": "wigglycode.lowcode.save",
        "title": "Save",
        "category": "WigglyCode",
        "icon": "$(save)"
      },
      {
        "command": "wigglycode.lowcode.share",
        "title": "Share",
        "category": "WigglyCode",
        "icon": "$(share)"
      },
      {
        "command": "wigglycode.lowcode.publish",
        "title": "Publish",
        "category": "WigglyCode",
        "icon": "$(rocket)"
      },
      {
        "command": "wigglycode.lowcode.insertComponent",
        "title": "Insert Component",
        "category": "WigglyCode",
        "icon": "$(add)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wigglycode-project",
          "title": "项目",
          "icon": "$(files)"
        },
        {
          "id": "wigglycode-components",
          "title": "组件库",
          "icon": "$(symbol-structure)"
        },
        {
          "id": "wigglycode-variables",
          "title": "变量",
          "icon": "$(symbol-variable)"
        },
        {
          "id": "wigglycode-datasources",
          "title": "数据源",
          "icon": "$(database)"
        },
        {
          "id": "wigglycode-outline",
          "title": "大纲",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "wigglycode-project": [
        {
          "id": "wigglycode.project",
          "name": "项目"
        }
      ],
      "wigglycode-components": [
        {
          "type": "webview",
          "id": "wigglycode.components",
          "name": "组件库"
        }
      ],
      "wigglycode-variables": [
        {
          "id": "wigglycode.variables",
          "name": "变量"
        }
      ],
      "wigglycode-datasources": [
        {
          "id": "wigglycode.datasources",
          "name": "数据源"
        }
      ],
      "wigglycode-outline": [
        {
          "id": "wigglycode.outline",
          "name": "大纲"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "wigglycode.lowcode.initializeProject",
          "when": "view == wigglycode.project",
          "group": "navigation"
        },
        {
          "command": "wigglycode.lowcode.openDesigner",
          "when": "view == wigglycode.project",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "wigglycode.lowcode.designMode",
          "when": "activeWebviewPanelId == 'wigglycode.lowcode.designer'",
          "group": "navigation@1"
        },
        {
          "command": "wigglycode.lowcode.previewMode",
          "when": "activeWebviewPanelId == 'wigglycode.lowcode.designer'",
          "group": "navigation@2"
        },
        {
          "command": "wigglycode.lowcode.codeMode",
          "when": "activeWebviewPanelId == 'wigglycode.lowcode.designer'",
          "group": "navigation@3"
        },
        {
          "command": "wigglycode.lowcode.panTool",
          "when": "activeWebviewPanelId == 'wigglycode.lowcode.designer' && !wigglycode.lowcode.panToolActive",
          "group": "navigation@4"
        },
        {
          "command": "wigglycode.lowcode.selectTool",
          "when": "activeWebviewPanelId == 'wigglycode.lowcode.designer' && wigglycode.lowcode.panToolActive",
          "group": "navigation@4"
        },
        {
          "command": "wigglycode.lowcode.zoomOut",
          "when": "activeWebviewPanelId == 'wigglycode.lowcode.designer'",
          "group": "navigation@6"
        },
        {
          "command": "wigglycode.lowcode.zoomIn",
          "when": "activeWebviewPanelId == 'wigglycode.lowcode.designer'",
          "group": "navigation@7"
        },
        {
          "command": "wigglycode.lowcode.resetViewport",
          "when": "activeWebviewPanelId == 'wigglycode.lowcode.designer'",
          "group": "navigation@8"
        },
        {
          "command": "wigglycode.lowcode.undo",
          "when": "activeWebviewPanelId == 'wigglycode.lowcode.designer'",
          "group": "navigation@9"
        },
        {
          "command": "wigglycode.lowcode.redo",
          "when": "activeWebviewPanelId == 'wigglycode.lowcode.designer'",
          "group": "navigation@10"
        },
        {
          "command": "wigglycode.lowcode.save",
          "when": "activeWebviewPanelId == 'wigglycode.lowcode.designer'",
          "group": "navigation@11"
        },
        {
          "command": "wigglycode.lowcode.share",
          "when": "activeWebviewPanelId == 'wigglycode.lowcode.designer'",
          "group": "navigation@12"
        },
        {
          "command": "wigglycode.lowcode.publish",
          "when": "activeWebviewPanelId == 'wigglycode.lowcode.designer'",
          "group": "navigation@13"
        }
      ]
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:lowcode && npm run build-webview",
    "watch": "npm run build-webview && gulp watch-extension:lowcode",
    "vscode:prepublish": "npm run build-ext && npm run build-webview",
    "build-ext": "node --experimental-strip-types ../../node_modules/gulp/bin/gulp.js --gulpfile ../../build/gulpfile.extensions.ts compile-extension:lowcode",
    "build-webview": "node ./esbuild.webview.mts",
    "compile-web": "npm-run-all2 -lp bundle-web typecheck-web",
    "bundle-web": "node ./esbuild.browser.mts",
    "typecheck-web": "node ../../node_modules/@typescript/native/lib/tsc.js --project ./tsconfig.json --noEmit",
    "watch-web": "npm-run-all2 -lp watch-bundle-web watch-typecheck-web",
    "watch-bundle-web": "node ./esbuild.browser.mts --watch",
    "watch-typecheck-web": "node ../../node_modules/@typescript/native/lib/tsc.js --project ./tsconfig.json --noEmit --watch"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.35.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nanoid": "^5.1.16",
    "react": "19.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.x",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vscode-webview": "^1.57.0",
    "postcss": "^8",
    "tailwindcss": "^4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
